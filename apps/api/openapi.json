{
  "openapi": "3.1.0",
  "info": {
    "title": "Agente de Tráfego API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "SignupInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "orgName": {
            "type": "string",
            "minLength": 2
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "orgName"
        ]
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MeOutput": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "orgId": {
            "type": [
              "string",
              "null"
            ]
          },
          "orgName": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "owner",
              "member"
            ]
          },
          "accessStatus": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pending",
              "active",
              "revoked"
            ]
          }
        },
        "required": [
          "userId",
          "email",
          "name",
          "orgId",
          "orgName",
          "role",
          "accessStatus"
        ]
      },
      "CreateOrgInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          }
        },
        "required": [
          "name"
        ]
      },
      "OrgOutput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ]
      },
      "AccessStatusOutput": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "revoked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "UsageSummaryOutput": {
        "type": "object",
        "properties": {
          "orgId": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "totalCostUsd": {
            "type": "number"
          },
          "byType": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "orgId",
          "period",
          "totalCostUsd",
          "byType"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/auth/signup": {
      "post": {
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "sessão criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOutput"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "sessão",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOutput"
                }
              }
            }
          },
          "401": {
            "description": "credenciais inválidas"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "sessão encerrada"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "sessão corrente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOutput"
                }
              }
            }
          },
          "401": {
            "description": "não autenticado"
          }
        }
      }
    },
    "/api/orgs": {
      "get": {
        "tags": [
          "orgs"
        ],
        "responses": {
          "200": {
            "description": "orgs do usuário",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrgOutput"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "orgs"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrgInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "org criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgOutput"
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/access-status": {
      "get": {
        "tags": [
          "billing"
        ],
        "responses": {
          "200": {
            "description": "status de acesso da org",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessStatusOutput"
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/usage": {
      "get": {
        "tags": [
          "billing"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "period",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "resumo de uso do período",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageSummaryOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
