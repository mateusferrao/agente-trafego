{
  "openapi": "3.1.0",
  "info": {
    "title": "Agente de Tráfego API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "SignupInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "orgName": {
            "type": "string",
            "minLength": 2
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "orgName"
        ]
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MeOutput": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "orgId": {
            "type": [
              "string",
              "null"
            ]
          },
          "orgName": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "owner",
              "member"
            ]
          },
          "accessStatus": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pending",
              "active",
              "revoked"
            ]
          }
        },
        "required": [
          "userId",
          "email",
          "name",
          "orgId",
          "orgName",
          "role",
          "accessStatus"
        ]
      },
      "CreateOrgInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          }
        },
        "required": [
          "name"
        ]
      },
      "RenameOrgInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          }
        },
        "required": [
          "name"
        ]
      },
      "OrgOutput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ]
      },
      "AccessStatusOutput": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "revoked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "UsageSummaryOutput": {
        "type": "object",
        "properties": {
          "orgId": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "totalCostUsd": {
            "type": "number"
          },
          "byType": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "orgId",
          "period",
          "totalCostUsd",
          "byType"
        ]
      },
      "ConnectTokenInput": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 20
          }
        },
        "required": [
          "token"
        ]
      },
      "ConnectAccountsOutput": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "currency": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ]
            }
          }
        },
        "required": [
          "accounts"
        ]
      },
      "SelectAccountInput": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 20
          },
          "adAccountId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "token",
          "adAccountId"
        ]
      },
      "AdAccountOutput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "adAccountId": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "tokenStatus": {
            "type": "string",
            "enum": [
              "valid",
              "invalid",
              "unchecked"
            ]
          },
          "lastValidatedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "adAccountId",
          "name",
          "currency",
          "tokenStatus",
          "lastValidatedAt"
        ]
      },
      "AgentSummary": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string"
          },
          "archetype": {
            "type": "string"
          },
          "goals": {
            "type": "object",
            "properties": {
              "targetCPA": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "targetROAS": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "required": [
          "agentId",
          "archetype",
          "goals"
        ]
      },
      "AgentGoalsInput": {
        "type": "object",
        "properties": {
          "targetCPA": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "targetROAS": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "TriggerRunOutput": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "waiting_approval",
              "partial"
            ]
          }
        },
        "required": [
          "runId",
          "status"
        ]
      },
      "LatestRunOutput": {
        "type": "object",
        "properties": {
          "run": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "running",
                  "succeeded",
                  "failed",
                  "waiting_approval",
                  "partial"
                ]
              },
              "summary": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "partial": {
                "type": "boolean"
              },
              "costUsd": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "startedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "finishedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "metrics": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "kpis": {
                    "type": "object",
                    "properties": {
                      "spend": {
                        "type": "number"
                      },
                      "impressions": {
                        "type": "number"
                      },
                      "clicks": {
                        "type": "number"
                      },
                      "ctr": {
                        "type": "number"
                      },
                      "cpa": {
                        "type": "number"
                      },
                      "roas": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "spend",
                      "impressions",
                      "clicks",
                      "ctr"
                    ]
                  },
                  "funnel": {
                    "type": "object",
                    "properties": {
                      "counts": {
                        "type": "object",
                        "properties": {
                          "conversation_started": {
                            "type": "number"
                          },
                          "first_reply": {
                            "type": "number"
                          },
                          "depth_2": {
                            "type": "number"
                          },
                          "depth_3": {
                            "type": "number"
                          },
                          "depth_5": {
                            "type": "number"
                          },
                          "replied": {
                            "type": "number"
                          }
                        }
                      },
                      "replyRate": {
                        "type": "number"
                      },
                      "depthRate": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "counts"
                    ]
                  },
                  "scorecard": {
                    "type": "object",
                    "properties": {
                      "grade": {
                        "type": "string",
                        "enum": [
                          "A",
                          "B",
                          "C",
                          "D"
                        ]
                      },
                      "headline": {
                        "type": "string"
                      },
                      "biggestLeak": {
                        "type": "string",
                        "enum": [
                          "consciencia",
                          "engajamento",
                          "conversao",
                          "receita"
                        ]
                      }
                    },
                    "required": [
                      "grade",
                      "headline",
                      "biggestLeak"
                    ]
                  }
                },
                "required": [
                  "kpis"
                ]
              }
            },
            "required": [
              "id",
              "status",
              "summary",
              "partial",
              "costUsd",
              "startedAt",
              "finishedAt",
              "metrics"
            ]
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "rationale": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "riskLevel": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "applicability": {
                  "type": "string",
                  "enum": [
                    "applicable",
                    "not_yet_applicable"
                  ]
                },
                "proposedAction": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "pause_entity",
                        "resume_entity",
                        "adjust_budget",
                        "set_status"
                      ]
                    },
                    "target": {
                      "type": "object",
                      "properties": {
                        "level": {
                          "type": "string",
                          "enum": [
                            "account",
                            "campaign",
                            "adset",
                            "ad"
                          ]
                        },
                        "id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "level",
                        "id"
                      ]
                    },
                    "params": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "type",
                    "target",
                    "params"
                  ]
                }
              },
              "required": [
                "id",
                "title",
                "rationale",
                "riskLevel",
                "applicability",
                "proposedAction"
              ]
            }
          }
        },
        "required": [
          "run",
          "recommendations"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/auth/signup": {
      "post": {
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "sessão criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOutput"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "sessão",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOutput"
                }
              }
            }
          },
          "401": {
            "description": "credenciais inválidas"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "sessão encerrada"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "sessão corrente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOutput"
                }
              }
            }
          },
          "401": {
            "description": "não autenticado"
          }
        }
      }
    },
    "/api/orgs": {
      "get": {
        "tags": [
          "orgs"
        ],
        "responses": {
          "200": {
            "description": "orgs do usuário",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrgOutput"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "orgs"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrgInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "org criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgOutput"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/current": {
      "patch": {
        "tags": [
          "orgs"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameOrgInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "org renomeada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgOutput"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/connect": {
      "post": {
        "tags": [
          "accounts"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectTokenInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "contas acessíveis pelo token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectAccountsOutput"
                }
              }
            }
          },
          "400": {
            "description": "token inválido ou sem permissões"
          }
        }
      }
    },
    "/api/accounts/select": {
      "post": {
        "tags": [
          "accounts"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectAccountInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "conta conectada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdAccountOutput"
                }
              }
            }
          },
          "400": {
            "description": "conta inacessível com esse token"
          }
        }
      }
    },
    "/api/accounts": {
      "get": {
        "tags": [
          "accounts"
        ],
        "responses": {
          "200": {
            "description": "contas conectadas da org",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AdAccountOutput"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{id}/agent": {
      "get": {
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "agente da conta (cria se não existir)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{id}/agent/goals": {
      "put": {
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentGoalsInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "meta atualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{id}/runs": {
      "post": {
        "tags": [
          "runs"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "202": {
            "description": "análise enfileirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriggerRunOutput"
                }
              }
            }
          },
          "409": {
            "description": "já há uma análise em andamento"
          }
        }
      }
    },
    "/api/accounts/{id}/runs/latest": {
      "get": {
        "tags": [
          "runs"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "último run + recomendações",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatestRunOutput"
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/access-status": {
      "get": {
        "tags": [
          "billing"
        ],
        "responses": {
          "200": {
            "description": "status de acesso da org",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessStatusOutput"
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/usage": {
      "get": {
        "tags": [
          "billing"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "period",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "resumo de uso do período",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageSummaryOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
