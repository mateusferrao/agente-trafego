{
  "name": "@trafego/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/composition.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/http/server.ts",
    "build": "tsc",
    "start": "tsx src/http/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "openapi": "tsx src/openapi/generate.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.0.0",
    "@node-rs/argon2": "^2.1.0",
    "@trafego/ads-meta": "workspace:*",
    "@trafego/agent-config": "workspace:*",
    "@trafego/approval-postgres": "workspace:*",
    "@trafego/channel-evolution": "workspace:*",
    "@trafego/config": "workspace:*",
    "@trafego/core": "workspace:*",
    "@trafego/creative-library": "workspace:*",
    "@trafego/credential-vault": "workspace:*",
    "@trafego/db": "workspace:*",
    "@trafego/metering-postgres": "workspace:*",
    "@trafego/scheduler-bullmq": "workspace:*",
    "@trafego/shared": "workspace:*",
    "@trafego/storage-local": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.0",
    "pino": "^9.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
