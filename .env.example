# ─── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── HTTP / Auth ───────────────────────────────────────────────────────
API_PORT=3333
WEB_ORIGIN=http://localhost:4200
# Origin público da API (URL do webhook Evolution). Prod = domínio público.
API_ORIGIN=http://localhost:3333

# ─── Postgres (Drizzle) ────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trafego

# ─── Redis (BullMQ) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# aplica migrations no boot da api (idempotente). false = migrar fora (CI/release)
AUTO_MIGRATE=true

# ─── Credential Vault (AES-256-GCM) ────────────────────────────────────
# chave mestra base64 (32 bytes) — secret do EasyPanel em produção
CREDENTIAL_MASTER_KEY=
CREDENTIAL_KEY_VERSION=1

# ─── LLM (OpenRouter) ──────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# modelo FORTE p/ validar a qualidade da análise (3a); trocável a qualquer momento
OPENROUTER_MODEL=x-ai/grok-4.5
# reviewer desacoplado do synthesis: refina/corta (nunca inventa), roda barato e não-reasoning (schema enforçado)
OPENROUTER_REVIEW_MODEL=google/gemini-3.7-flash
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
# map-reduce (3b-2): modelo barato por-anúncio (mapa) + redator do WhatsApp
OPENROUTER_UNIT_MODEL=deepseek/deepseek-v4-flash-0731
# reserva do unit (provider diverso; não-reasoning; barato; enforça JSON-schema)
OPENROUTER_UNIT_FALLBACK_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_MESSAGE_MODEL=google/gemini-3.1-flash-lite
# versão do analisador de visão — bumpar invalida o cache de análises de criativo
CREATIVE_VISION_ANALYZER_VERSION=4
ANALYSIS_VISION_FRAMES=4
# retentativas in-process por chamada de LLM (429/5xx/rede)
LLM_MAX_RETRIES=3
# revisor (Analista→Revisor) da análise; override por-agente em agents.model_config
ANALYSIS_REVIEW_ENABLED=true
# teto de tokens de saída por chamada de LLM
ANALYSIS_MAX_OUTPUT_TOKENS=8000
# cap de custo LLM por org por período (USD); 0 = sem cap
LLM_COST_CAP_USD_PER_PERIOD=0

# ─── Meta (Graph API) ───────────────────────────────────────────────────
# Opcionais por enquanto: o onboarding (1b) é token-only (cola token → /me/adaccounts).
# Voltam a ser necessários no fast-follow de escopos (/debug_token) + appsecret_proof.
META_APP_ID=
META_APP_SECRET=
META_HTTP_TIMEOUT_MS=30000

# ─── WhatsApp (Evolution) ──────────────────────────────────────────────
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_HTTP_TIMEOUT_MS=30000
# secret que validamos no webhook inbound
EVOLUTION_WEBHOOK_SECRET=

# ─── Análise / Governor ────────────────────────────────────────────────
INSIGHTS_RETENTION_DAYS=90
# dias recentes re-baixados a cada sync (conversões atribuídas a dias passados)
INSIGHTS_REFETCH_WINDOW_DAYS=7
# TTL (s) do cache Redis das conversões personalizadas por conta
CUSTOM_CONVERSIONS_CACHE_TTL_SEC=21600
# TTL (s) do cache Redis do catálogo de entidades por conta (corta o listEntities
# full a cada run = rate-limit). Invalidado na escrita real. 0 = desliga o cache.
META_ENTITY_CACHE_TTL_SEC=1800
# frescura (6a): idade máx (min) do snapshot antes de disparar sync-only (porta
# shouldSync, compartilhada por sweep/lazy/análise/botão) + intervalo do sweep. ~2-3h.
INSIGHTS_FRESH_THRESHOLD_MIN=120
# breakdown demografico/posicionamento (S7, pivo saude) - cadencia PROPRIA, bem mais lenta (default 7 dias)
INSIGHTS_BREAKDOWN_STALE_THRESHOLD_MIN=10080
# contas zeradas (dormância): dias sem atividade (relógio = última atividade OU conexão)
# até a conta virar dormante (backoff: remove análise+pulso; sweep vigia lento)
DORMANT_AFTER_DAYS=7
# cadência lenta (min) do sweep numa conta dormante (default 1×/dia) — corta chamadas Meta
DORMANT_SWEEP_INTERVAL_MIN=1440
ANALYSIS_MAX_CREATIVES_VISION=8
# janela da análise on-demand (3a): últimos N dias vs os N anteriores
ANALYSIS_WINDOW_DAYS=7
ANALYSIS_BASELINE_DAYS=7
# entidades por nível no brief (top-N por spend + flagadas)
# campanhas que recebem análise profunda (flagadas/mudadas sempre entram; resto resumido)
ANALYSIS_TOP_N=10
# qualidade (Fatia 6c) — limiares de significância/fadiga/zombie (override por-agente)
ANALYSIS_QUALITY_MIN_CONVERSIONS=20
ANALYSIS_QUALITY_MIN_CLICKS=100
ANALYSIS_QUALITY_FATIGUE_CTR_DROP_PCT=20
ANALYSIS_QUALITY_FATIGUE_FREQUENCY=3
ANALYSIS_QUALITY_FREQUENCY_CAP_PROSPECTING=2.5
ANALYSIS_QUALITY_FREQUENCY_CAP_REMARKETING=8
ANALYSIS_QUALITY_FATIGUE_COST_RISE_PCT=30
ANALYSIS_QUALITY_ZOMBIE_MIN_SPEND=50
ANALYSIS_QUALITY_TRACKING_BROKEN_RATIO=50
ANALYSIS_QUALITY_TRACKING_BROKEN_MIN_FUNNEL=50
ANALYSIS_QUALITY_COLD_START_REFERENCE=true
# piso de elegibilidade relativo (playbook real, pivô saúde): gasto >= 2x o CPA-alvo já conta como volume
ANALYSIS_QUALITY_RELATIVE_ELIGIBILITY_SPEND_MULTIPLIER=2
# CPA marginal (pivô saúde, squad): alta (%) do CPA vs baseline que rebaixa escalar -> investigar
ANALYSIS_QUALITY_MARGINAL_CPA_WORSEN_PCT=20
# retenção de vídeo (S6, %) abaixo disso = gancho fraco na largada (25% do vídeo)
ANALYSIS_QUALITY_WEAK_HOOK_RETENTION_MAX_PCT=50
# anúncios detalhados por campanha (resto vira cauda agregada por adset)
ANALYSIS_NOTABLE_ADS_PER_CAMPAIGN=5
# teto de criativos com visão por campanha (prioriza maior gasto/flag)
ANALYSIS_MAX_CREATIVES_VISION_PER_CAMPAIGN=3
# quantas campanhas o mapa analisa em paralelo (pool bounded)
ANALYSIS_MAP_CONCURRENCY=8

# ─── Cadência (cron por conta — 3b) ────────────────────────────────────
# cron 5-campos (default global; edição por-conta = Fatia 4)
ANALYSIS_CRON_DEFAULT=0 8 * * *
ANALYSIS_TZ=America/Sao_Paulo
# stagger máx. (ms) entre contas p/ não bater o rate-limit da Meta juntas
ANALYSIS_CRON_JITTER_MS=300000
# política de execução: deep_periodic_incremental | full_every_run | budget_scaled
ANALYSIS_EXECUTION_POLICY=deep_periodic_incremental
# intervalo (dias) entre análises DEEP completas na política incremental
ANALYSIS_DEEP_INTERVAL_DAYS=7
# variação relativa (%) de métrica que torna uma unidade "materialmente mudada"
ANALYSIS_MATERIAL_CHANGE_PCT=15
# reaper: idade (min) além da qual um run pending/running preso (crash) é marcado failed
ANALYSIS_RUN_STALE_MINUTES=30
# cadência do reaper (cron 5-campos)
ANALYSIS_REAPER_CRON=*/15 * * * *
# cadência da expiração de aprovações (5b) — varre pendentes vencidas (24h)
APPROVAL_EXPIRY_CRON=*/15 * * * *
# janela (dias) em que "reverter" uma ação segue disponível (5b)
REVERT_TTL_DAYS=7

# ─── Conversa (WhatsApp Grafo B — 5b-2) ────────────────────────────────
CONVERSATION_MODEL=openai/gpt-5.6-luna
# reserva do chat (provider diverso; se o primário esgotar o retry)
CONVERSATION_FALLBACK_MODEL=openai/gpt-4.1-mini
CONVERSATION_HISTORY_TURNS=8
CONVERSATION_MAX_TOKENS=6000
CONVERSATION_DEBOUNCE_SECONDS=5
CONVERSATION_TURN_TIMEOUT_MS=90000
# teto do fetch ao vivo da Meta numa read-tool do chat (degrada pro persistido; < turn timeout)
CHAT_LIVE_FETCH_TIMEOUT_MS=30000
# teto do fetch ao vivo da Meta na leitura de campanhas da API (site) — curto, degrada em silêncio
RUNS_LIVE_GAP_CHECK_TIMEOUT_MS=4000
# modelo default da geração de copy do rascunho (override por-agente em model_config)
COPY_MODEL=openai/gpt-4o-mini
ANALYSIS_REASONING_EFFORT=medium

# ─── Transcrição de áudio inbound (STT via OpenRouter) ─────────────────
# Nota de voz do WhatsApp → texto na borda. Reusa OPENROUTER_API_KEY/BASE_URL.
TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
# dica de idioma ISO-639-1 (melhora PT-BR); vazio = auto-detect
TRANSCRIPTION_LANGUAGE=pt
TRANSCRIPTION_MAX_AUDIO_MB=16
TRANSCRIPTION_TIMEOUT_MS=60000
# janela (s) do throttle dos avisos de cortesia (1 aviso/conversa/motivo por janela)
NOTICE_THROTTLE_SECONDS=60
# kill-switch de PLATAFORMA do ingest de contexto de grupo: mensagem NÃO-dirigida
# (sem @menção/reply ao bot) vira contexto ambiente quando a org tem grupo registrado.
# desligar aqui corta o ingest p/ todas as orgs (controle org-facing = fast-follow)
TRAFEGO_GROUP_INGEST_CONTEXT=true
# retenção (dias) do dado ambiente de grupo (purge diário) — alinhado a insights (~90d)
GROUP_CONTEXT_RETENTION_DAYS=90
# transcript ambiente injetado no prompt (turno de grupo dirigido): teto de mensagens,
# janela de tempo e teto de tokens (separados da janela do state.messages)
GROUP_CONTEXT_MAX_MESSAGES=25
GROUP_CONTEXT_WINDOW_HOURS=24
GROUP_CONTEXT_MAX_TOKENS=1500
# staleness do foco de conta (multi-conta): foco cujo último uso passou desse TTL perde
# precedência (grupo → contexto ambiente; DM → "qual conta?")
CONVERSATION_FOCUS_TTL_HOURS=12
# cron do purge do contexto ambiente de grupo (retenção/LGPD) — diário
GROUP_CONTEXT_PURGE_CRON=0 4 * * *
# TTL (s) do cache do mapa LID→telefone dos participantes de um grupo (resolve
# menção/reply endereçada por LID — grupo migrado, WhatsApp addressingMode "lid")
GROUP_PARTICIPANTS_CACHE_TTL_SEC=3600

# ─── Email (auth transacional — 6b) ────────────────────────────────────
# driver: console (dev, loga o código/link no log) | ses (prod, AWS SESv2) | noop
AUTH_EMAIL_DELIVERY_DRIVER=console
AUTH_EMAIL_FROM=CaquiAI <no-reply@msg.automato.pro>
# Região do SES de produção. Creds AWS abaixo (só o worker envia; IAM escopado a ses:SendEmail).
AWS_REGION=sa-east-1
# Credenciais do IAM user trafego-ses-mailer (SÓ no serviço worker; nunca commitar valores reais).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# TTLs dos tokens de email (min)
AUTH_EMAIL_TOKEN_TTL_MINUTES=15
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# URL pública do app (monta o link de reset de senha)
FRONTEND_URL=http://localhost:4200

# ─── Observabilidade (opcional) ────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
