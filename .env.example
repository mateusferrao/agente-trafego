# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── HTTP / Auth ─────────────────────────────────────────────────────────
API_PORT=3333
WEB_ORIGIN=http://localhost:4200

# ─── Postgres (Drizzle) ──────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trafego

# ─── Redis (BullMQ) ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# aplica migrations no boot da api (idempotente). false = migrar fora (CI/release)
AUTO_MIGRATE=true

# ─── Credential Vault (AES-256-GCM) ──────────────────────────────────────
# chave mestra base64 (32 bytes) — secret do EasyPanel em produção
CREDENTIAL_MASTER_KEY=
CREDENTIAL_KEY_VERSION=1

# ─── LLM (OpenRouter) ────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# cap de custo LLM por org por período (USD); 0 = sem cap
LLM_COST_CAP_USD_PER_PERIOD=0

# ─── Meta (Graph API) ────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=

# ─── WhatsApp (Evolution) ────────────────────────────────────────────────
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
# secret que validamos no webhook inbound
EVOLUTION_WEBHOOK_SECRET=
# instância Evolution única da org (Fatia 0: via env)
EVOLUTION_INSTANCE=

# ─── Fatia 0 (scaffolding — removido quando houver UI/auth/contatos) ──────
# guard dos endpoints admin até a auth real (1a)
BETA_ADMIN_SECRET=
# destinatário fixo do WhatsApp: só dígitos com DDI (ex: 5511999999999)
FATIA0_RECIPIENT_PHONE=

# ─── Análise / Governor ──────────────────────────────────────────────────
INSIGHTS_RETENTION_DAYS=90
ANALYSIS_MAX_CREATIVES_VISION=8

# ─── Observabilidade (opcional) ──────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
