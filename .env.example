# â”€â”€â”€ AnÃ¡lise / Governor â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
INSIGHTS_RETENTION_DAYS=90
# dias recentes re-baixados a cada sync (conversÃµes atribuÃ­das a dias passados)
INSIGHTS_REFETCH_WINDOW_DAYS=7
# TTL (s) do cache Redis das conversÃµes personalizadas por conta
CUSTOM_CONVERSIONS_CACHE_TTL_SEC=21600
ANALYSIS_MAX_CREATIVES_VISION=8
# janela da anÃ¡lise on-demand (3a): Ãºltimos N dias vs os N anteriores
ANALYSIS_WINDOW_DAYS=7
ANALYSIS_BASELINE_DAYS=7
# entidades por nÃ­vel no brief (top-N por spend + flagadas)
# campanhas que recebem analise profunda (flagadas/mudadas sempre entram; resto resumido)
ANALYSIS_TOP_N=10
# anuncios detalhados por campanha (resto vira cauda agregada por adset)
ANALYSIS_NOTABLE_ADS_PER_CAMPAIGN=5
# teto de criativos com visao por campanha (prioriza maior gasto/flag)
ANALYSIS_MAX_CREATIVES_VISION_PER_CAMPAIGN=3
# quantas campanhas o mapa analisa em paralelo (pool bounded)
ANALYSIS_MAP_CONCURRENCY=8

# â”€â”€â”€ CadÃªncia (cron por conta â€” 3b) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# cron 5-campos (default global; ediÃ§Ã£o por-conta = Fatia 4)
ANALYSIS_CRON_DEFAULT=0 8 * * *
ANALYSIS_TZ=America/Sao_Paulo
# stagger mÃ¡x. (ms) entre contas p/ nÃ£o bater o rate-limit da Meta juntas
ANALYSIS_CRON_JITTER_MS=300000
# polÃ­tica de execuÃ§Ã£o: deep_periodic_incremental | full_every_run | budget_scaled
ANALYSIS_EXECUTION_POLICY=deep_periodic_incremental
# intervalo (dias) entre anÃ¡lises DEEP completas na polÃ­tica incremental
ANALYSIS_DEEP_INTERVAL_DAYS=7
# variaÃ§Ã£o relativa (%) de mÃ©trica que torna uma unidade "materialmente mudada"
ANALYSIS_MATERIAL_CHANGE_PCT=15
# reaper: idade (min) alÃ©m da qual um run pending/running preso (crash) Ã© marcado failed
ANALYSIS_RUN_STALE_MINUTES=30
# cadÃªncia do reaper (cron 5-campos)
ANALYSIS_REAPER_CRON=*/15 * * * *

