{
  "name": "trafego-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r --filter=!web test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @trafego/db db:generate",
    "db:migrate": "pnpm --filter @trafego/db db:migrate",
    "db:seed": "tsx --env-file=.env packages/db/src/seed.ts",
    "db:q": "tsx --env-file=.env packages/db/src/query.ts",
    "db:deploy": "tsx packages/db/src/migrate.ts && pnpm db:seed",
    "access:grant": "tsx --env-file=.env apps/api/src/scripts/access.ts grant",
    "access:revoke": "tsx --env-file=.env apps/api/src/scripts/access.ts revoke",
    "access:list": "tsx --env-file=.env apps/api/src/scripts/access.ts list",
    "backfill:access": "tsx --env-file=.env apps/api/src/scripts/backfill-access.ts",
    "backfill:usage-account": "tsx --env-file=.env apps/api/src/scripts/backfill-usage-account.ts",
    "backfill:archetype": "tsx --env-file=.env apps/api/src/scripts/backfill-archetype.ts",
    "backfill:notify-reactivation": "tsx --env-file=.env apps/api/src/scripts/backfill-notify-reactivation.ts",
    "backfill:identity-seeds": "tsx --env-file=.env apps/api/src/scripts/backfill-identity-seeds.ts",
    "resync:webhooks": "tsx --env-file=.env apps/api/src/scripts/resync-webhooks.ts",
    "api:generate": "pnpm --filter @trafego/api openapi && pnpm --filter web api:generate",
    "e2e:learning": "apps/worker/e2e-learning.sh"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
